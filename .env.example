# ── Banco (Supabase Postgres via pooler — o host direto é IPv6-only) ─────────
# Runtime: modo transaction (porta 6543), driver pg via @prisma/adapter-pg
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"
# Migrations/seed (prisma migrate): modo session (porta 5432)
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase (Auth/Storage) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Observabilidade (opcional — vazio desativa o Sentry) ────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="info"

# ── E-mail transacional (opcional — vazio: lembretes só logam, não enviam) ──
RESEND_API_KEY=""
EMAIL_FROM="Clínica <nao-responda@seu-dominio.com>"

# ── Jobs internos (Cloud Scheduler) ─────────────────────────────────────────
# Produção: JOBS_OIDC_AUDIENCE = URL do endpoint (token OIDC do Google).
# Dev/local: JOBS_SECRET = segredo compartilhado enviado como Bearer.
JOBS_OIDC_AUDIENCE=""
JOBS_SECRET=""
