generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  authId    String   @unique @map("auth_id") @db.Uuid
  name      String
  email     String   @unique
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      OrganizationMember[]
  assignedPatients Patient[]            @relation("PatientAssignedTo")
  patientProfiles  Patient[]            @relation("PatientPortalUser")

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key         String   @unique
  name        String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMember[]

  @@map("roles")
}

model Organization {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  settings  Json     @default("{}")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members            OrganizationMember[]
  foodCategories     FoodCategory[]
  mealTypes          MealType[]
  examTypes          ExamType[]
  foods              Food[]
  foodMeasures       FoodMeasure[]
  recipes            Recipe[]
  patients           Patient[]
  attachments        Attachment[]
  mealPlans          MealPlan[]
  diaryEntries       FoodDiaryEntry[]
  assessments        Assessment[]
  energyCalculations EnergyCalculation[]
  anamnesisTemplates AnamnesisTemplate[]
  anamnesisResponses AnamnesisResponse[]
  patientExams       PatientExam[]

  @@map("organizations")
}

enum MemberStatus {
  active
  invited
  suspended

  @@map("member_status")
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("organization_members")
}

// ─── Catálogos globais (Regra Enum vs Catálogo — docs/ARQUITETURA.md §3.1) ───

model NutrientGroup {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  nutrients Nutrient[]

  @@map("nutrient_groups")
}

model Nutrient {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key             String   @unique
  name            String
  unit            String
  nutrientGroupId String   @map("nutrient_group_id") @db.Uuid
  decimals        Int      @default(2)
  isCore          Boolean  @default(false) @map("is_core")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  nutrientGroup       NutrientGroup        @relation(fields: [nutrientGroupId], references: [id])
  foodNutrients       FoodNutrient[]
  planNutrientTargets PlanNutrientTarget[]

  @@index([nutrientGroupId])
  @@map("nutrients")
}

enum UnitType {
  mass
  volume
  unit

  @@map("unit_type")
}

model MeasurementUnit {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key          String   @unique
  name         String
  abbreviation String
  type         UnitType
  gramsPerUnit Decimal? @map("grams_per_unit") @db.Decimal(12, 4)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipeIngredients RecipeIngredient[]
  mealItems         MealItem[]

  @@map("measurement_units")
}

model FoodCategory {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  color          String?
  sortOrder      Int      @default(0) @map("sort_order")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id])
  foods        Food[]

  @@unique([organizationId, name])
  @@map("food_categories")
}

model FoodSource {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key         String   @unique
  name        String
  version     String?
  licenseNote String?  @map("license_note")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  foods Food[]

  @@map("food_sources")
}

model MealType {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  defaultTime    String?  @map("default_time")
  sortOrder      Int      @default(0) @map("sort_order")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id])
  planMeals    PlanMeal[]
  diaryEntries FoodDiaryEntry[]

  @@unique([organizationId, name])
  @@map("meal_types")
}

enum CalculationKind {
  energy_expenditure
  body_composition
  activity_factor

  @@map("calculation_kind")
}

model CalculationMethod {
  id                 String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key                String              @unique
  kind               CalculationKind
  name               String
  description        String?
  params             Json                @default("{}")
  sortOrder          Int                 @default(0) @map("sort_order")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessments        Assessment[]
  energyCalculations EnergyCalculation[]

  @@map("calculation_methods")
}

enum MeasurementGroup {
  basic
  skinfold
  circumference
  bioimpedance

  @@map("measurement_group")
}

model MeasurementType {
  id               String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key              String            @unique
  name             String
  unit             String
  group            MeasurementGroup
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessmentValues AssessmentValue[]

  @@map("measurement_types")
}

model ExamType {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  unit           String?
  referenceRange Json     @default("{}") @map("reference_range")
  isSystem       Boolean  @default(false) @map("is_system")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id])
  examResults  ExamResult[]

  @@unique([organizationId, name])
  @@map("exam_types")
}

// ─── Alimentos e receitas (Fase 2 — docs/ARQUITETURA.md §5.2-C) ──────────────

enum FoodBaseUnit {
  g
  ml

  @@map("food_base_unit")
}

model Food {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  foodSourceId   String       @map("food_source_id") @db.Uuid
  foodCategoryId String?      @map("food_category_id") @db.Uuid
  /// Código na fonte original (nº TACO/TBCA) — chave de idempotência do importador
  sourceCode     String?      @map("source_code")
  name           String
  /// Minúsculo e sem acentos — mantido pelo repositório em toda escrita
  nameNormalized String       @map("name_normalized")
  baseQty        Decimal      @default(100) @map("base_qty") @db.Decimal(10, 2)
  baseUnit       FoodBaseUnit @default(g) @map("base_unit")
  /// Cache denormalizado dos macros por 100 (fonte da verdade: food_nutrients)
  energyKcal     Decimal?     @map("energy_kcal") @db.Decimal(12, 4)
  proteinG       Decimal?     @map("protein_g") @db.Decimal(12, 4)
  carbohydrateG  Decimal?     @map("carbohydrate_g") @db.Decimal(12, 4)
  lipidG         Decimal?     @map("lipid_g") @db.Decimal(12, 4)
  isActive       Boolean      @default(true) @map("is_active")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization?      @relation(fields: [organizationId], references: [id])
  foodSource        FoodSource         @relation(fields: [foodSourceId], references: [id])
  foodCategory      FoodCategory?      @relation(fields: [foodCategoryId], references: [id])
  nutrients         FoodNutrient[]
  measures          FoodMeasure[]
  recipeIngredients RecipeIngredient[]
  mealItems         MealItem[]

  @@unique([foodSourceId, sourceCode])
  @@index([organizationId])
  @@index([foodCategoryId])
  @@map("foods")
}

model FoodNutrient {
  foodId     String  @map("food_id") @db.Uuid
  nutrientId String  @map("nutrient_id") @db.Uuid
  /// Quantidade por 100 g/ml (base do alimento)
  amount     Decimal @db.Decimal(12, 4)

  food     Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient Nutrient @relation(fields: [nutrientId], references: [id])

  @@id([foodId, nutrientId])
  @@map("food_nutrients")
}

model FoodMeasure {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  foodId         String   @map("food_id") @db.Uuid
  /// NULL = medida da fonte oficial; preenchido = medida criada pela clínica
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  gramWeight     Decimal  @map("gram_weight") @db.Decimal(10, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  food         Food          @relation(fields: [foodId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([foodId])
  @@map("food_measures")
}

model Recipe {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  nameNormalized String   @map("name_normalized")
  /// Nº de porções que a receita rende
  servings       Decimal  @default(1) @db.Decimal(6, 2)
  /// Peso final após preparo (g). NULL = soma dos ingredientes crus
  yieldGrams     Decimal? @map("yield_grams") @db.Decimal(10, 2)
  instructions   String?
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id])
  ingredients  RecipeIngredient[]
  mealItems    MealItem[]

  @@index([organizationId])
  @@map("recipes")
}

model RecipeIngredient {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  recipeId          String   @map("recipe_id") @db.Uuid
  foodId            String   @map("food_id") @db.Uuid
  quantity          Decimal  @db.Decimal(10, 2)
  measurementUnitId String?  @map("measurement_unit_id") @db.Uuid
  foodMeasureId     String?  @map("food_measure_id") @db.Uuid
  /// Resolvido pelo motor no momento da escrita (princípio §3.3)
  resolvedGrams     Decimal  @map("resolved_grams") @db.Decimal(10, 2)
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipe          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food            Food             @relation(fields: [foodId], references: [id])
  measurementUnit MeasurementUnit? @relation(fields: [measurementUnitId], references: [id])

  @@index([recipeId])
  @@index([foodId])
  @@map("recipe_ingredients")
}

// ─── Pacientes e anexos (Fase 3 — docs/ARQUITETURA.md §5.2-A/F) ──────────────

/// Sexo biológico — entra nas fórmulas clínicas (enum, não catálogo: §3.1)
enum Sex {
  male
  female

  @@map("sex")
}

model Patient {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Profissional responsável
  assignedToId   String?   @map("assigned_to_id") @db.Uuid
  /// Preenchido quando o paciente ganha acesso ao portal (Fase 5)
  userId         String?   @map("user_id") @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  birthDate      DateTime? @map("birth_date") @db.Date
  sex            Sex?
  genderIdentity String?   @map("gender_identity")
  cpf            String?
  email          String?
  phone          String?
  occupation     String?
  notes          String?
  /// LGPD: momento do registro do consentimento de tratamento de dados
  consentAt      DateTime? @map("consent_at") @db.Timestamptz(6)
  /// Token de convite do portal — trocado pelo vínculo user_id no aceite
  inviteToken    String?   @unique @map("invite_token")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id])
  assignedTo         User?               @relation("PatientAssignedTo", fields: [assignedToId], references: [id])
  user               User?               @relation("PatientPortalUser", fields: [userId], references: [id])
  mealPlans          MealPlan[]
  diaryEntries       FoodDiaryEntry[]
  assessments        Assessment[]
  energyCalculations EnergyCalculation[]
  anamnesisResponses AnamnesisResponse[]
  patientExams       PatientExam[]

  @@unique([organizationId, userId])
  @@index([organizationId, nameNormalized])
  @@index([assignedToId])
  @@map("patients")
}

// ─── Ferramentas clínicas (Fase 6 — §5.2-E) — sempre com snapshot ────────────

/// Avaliação antropométrica: entradas em assessment_values, método via FK e
/// RESULTADOS congelados em `results` (Regra do Snapshot §3.3)
model Assessment {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  assessedAt          DateTime  @map("assessed_at") @db.Date
  calculationMethodId String?   @map("calculation_method_id") @db.Uuid
  /// Saídas calculadas na criação: imc, densidade, gorduraPct, massas…
  results             Json      @default("{}")
  notes               String?
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization       @relation(fields: [organizationId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  calculationMethod CalculationMethod? @relation(fields: [calculationMethodId], references: [id])
  values            AssessmentValue[]

  @@index([patientId, assessedAt])
  @@map("assessments")
}

model AssessmentValue {
  assessmentId      String  @map("assessment_id") @db.Uuid
  measurementTypeId String  @map("measurement_type_id") @db.Uuid
  value             Decimal @db.Decimal(10, 2)

  assessment      Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  measurementType MeasurementType @relation(fields: [measurementTypeId], references: [id])

  @@id([assessmentId, measurementTypeId])
  @@map("assessment_values")
}

/// Cálculo de gasto energético: entradas + método + resultado congelados
model EnergyCalculation {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  calculatedAt        DateTime  @map("calculated_at") @db.Date
  calculationMethodId String    @map("calculation_method_id") @db.Uuid
  inputs              Json      @default("{}")
  activityFactor      Decimal   @map("activity_factor") @db.Decimal(4, 3)
  tmbKcal             Decimal   @map("tmb_kcal") @db.Decimal(8, 2)
  getKcal             Decimal   @map("get_kcal") @db.Decimal(8, 2)
  adjustmentKcal      Decimal   @default(0) @map("adjustment_kcal") @db.Decimal(8, 2)
  finalKcal           Decimal   @map("final_kcal") @db.Decimal(8, 2)
  notes               String?
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization      @relation(fields: [organizationId], references: [id])
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  calculationMethod CalculationMethod @relation(fields: [calculationMethodId], references: [id])

  @@index([patientId, calculatedAt])
  @@map("energy_calculations")
}

/// Modelos de anamnese: do sistema (org NULL, seed) ou da clínica
model AnamnesisTemplate {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?       @relation(fields: [organizationId], references: [id])
  questions    AnamnesisQuestion[]
  responses    AnamnesisResponse[]

  @@unique([organizationId, name])
  @@map("anamnesis_templates")
}

enum AnamnesisQuestionType {
  text
  number
  boolean
  select
  multi
  scale

  @@map("anamnesis_question_type")
}

model AnamnesisQuestion {
  id         String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  templateId String                @map("template_id") @db.Uuid
  prompt     String
  type       AnamnesisQuestionType
  /// Para select/multi: lista de opções
  options    Json                  @default("[]")
  required   Boolean               @default(false)
  sortOrder  Int                   @default(0) @map("sort_order")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  template AnamnesisTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("anamnesis_questions")
}

/// Resposta de anamnese: answers carrega CÓPIA do texto das perguntas —
/// editar o modelo não reescreve anamneses antigas (Regra do Snapshot)
model AnamnesisResponse {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  templateId     String    @map("template_id") @db.Uuid
  answeredAt     DateTime  @map("answered_at") @db.Date
  /// [{questionId, prompt, type, answer}]
  answers        Json      @default("[]")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  template     AnamnesisTemplate @relation(fields: [templateId], references: [id])

  @@index([patientId, answeredAt])
  @@map("anamnesis_responses")
}

model PatientExam {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  collectedAt    DateTime  @map("collected_at") @db.Date
  labName        String?   @map("lab_name")
  notes          String?
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  results      ExamResult[]

  @@index([patientId, collectedAt])
  @@map("patient_exams")
}

model ExamResult {
  id            String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  patientExamId String  @map("patient_exam_id") @db.Uuid
  examTypeId    String  @map("exam_type_id") @db.Uuid
  value         Decimal @db.Decimal(12, 4)

  patientExam PatientExam @relation(fields: [patientExamId], references: [id], onDelete: Cascade)
  examType    ExamType    @relation(fields: [examTypeId], references: [id])

  @@unique([patientExamId, examTypeId])
  @@map("exam_results")
}

/// Diário alimentar do portal do paciente (Fase 5 — §5.2-F)
model FoodDiaryEntry {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  entryAt        DateTime @map("entry_at") @db.Timestamptz(6)
  mealTypeId     String?  @map("meal_type_id") @db.Uuid
  description    String
  photoPath      String?  @map("photo_path")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mealType     MealType?    @relation(fields: [mealTypeId], references: [id])

  @@index([patientId, entryAt])
  @@map("food_diary_entries")
}

/// Dono do anexo — polimorfismo controlado (enum: lógica ramifica por tipo)
enum AttachmentOwner {
  patient

  @@map("attachment_owner")
}

model Attachment {
  id             String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  ownerType      AttachmentOwner @map("owner_type")
  ownerId        String          @map("owner_id") @db.Uuid
  fileName       String          @map("file_name")
  storagePath    String          @unique @map("storage_path")
  mimeType       String          @map("mime_type")
  sizeBytes      Int             @map("size_bytes")
  createdBy      String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, ownerType, ownerId])
  @@map("attachments")
}

// ─── Planos alimentares (Fase 4 — docs/ARQUITETURA.md §5.2-D) ────────────────

/// Workflow do plano — a lógica ramifica por estado (enum, não catálogo: §3.1)
enum PlanStatus {
  draft
  active
  archived

  @@map("plan_status")
}

model MealPlan {
  id                  String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  /// NULL + isTemplate = modelo reutilizável (mesma estrutura, zero duplicação)
  patientId           String?    @map("patient_id") @db.Uuid
  name                String
  status              PlanStatus @default(draft)
  isTemplate          Boolean    @default(false) @map("is_template")
  startDate           DateTime?  @map("start_date") @db.Date
  endDate             DateTime?  @map("end_date") @db.Date
  notes               String?
  /// Congelado na ativação (Regra do Snapshot §3.3): totais + metas da época
  nutritionalSnapshot Json?      @map("nutritional_snapshot")
  /// Lock otimista do autosave (§7.2): conflito → cliente recarrega
  version             Int        @default(1)
  createdBy           String?    @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id])
  patient      Patient?             @relation(fields: [patientId], references: [id])
  days         PlanDay[]
  targets      PlanNutrientTarget[]

  @@index([organizationId, status])
  @@index([patientId])
  @@map("meal_plans")
}

model PlanNutrientTarget {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  mealPlanId String   @map("meal_plan_id") @db.Uuid
  nutrientId String   @map("nutrient_id") @db.Uuid
  targetMin  Decimal? @map("target_min") @db.Decimal(12, 4)
  targetMax  Decimal? @map("target_max") @db.Decimal(12, 4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  nutrient Nutrient @relation(fields: [nutrientId], references: [id])

  @@unique([mealPlanId, nutrientId])
  @@map("plan_nutrient_targets")
}

model PlanDay {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  mealPlanId String   @map("meal_plan_id") @db.Uuid
  name       String
  /// Dias da semana (0=domingo … 6=sábado) aos quais este dia se aplica
  weekdays   Int[]    @default([])
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mealPlan MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meals    PlanMeal[]

  @@index([mealPlanId])
  @@map("plan_days")
}

model PlanMeal {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  planDayId     String   @map("plan_day_id") @db.Uuid
  mealTypeId    String   @map("meal_type_id") @db.Uuid
  customName    String?  @map("custom_name")
  scheduledTime String?  @map("scheduled_time")
  sortOrder     Int      @default(0) @map("sort_order")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  planDay  PlanDay      @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  mealType MealType     @relation(fields: [mealTypeId], references: [id])
  options  MealOption[]

  @@index([planDayId])
  @@map("plan_meals")
}

model MealOption {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  planMealId String   @map("plan_meal_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  planMeal PlanMeal   @relation(fields: [planMealId], references: [id], onDelete: Cascade)
  items    MealItem[]

  @@index([planMealId])
  @@map("meal_options")
}

model MealItem {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  mealOptionId      String   @map("meal_option_id") @db.Uuid
  /// Exatamente um entre foodId e recipeId (CHECK no banco)
  foodId            String?  @map("food_id") @db.Uuid
  recipeId          String?  @map("recipe_id") @db.Uuid
  quantity          Decimal  @db.Decimal(10, 2)
  measurementUnitId String?  @map("measurement_unit_id") @db.Uuid
  foodMeasureId     String?  @map("food_measure_id") @db.Uuid
  /// Resolvido pelo motor na escrita (Regra do Snapshot §3.3)
  resolvedGrams     Decimal  @map("resolved_grams") @db.Decimal(10, 2)
  sortOrder         Int      @default(0) @map("sort_order")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mealOption      MealOption       @relation(fields: [mealOptionId], references: [id], onDelete: Cascade)
  food            Food?            @relation(fields: [foodId], references: [id])
  recipe          Recipe?          @relation(fields: [recipeId], references: [id])
  measurementUnit MeasurementUnit? @relation(fields: [measurementUnitId], references: [id])

  @@index([mealOptionId])
  @@index([foodId])
  @@index([recipeId])
  @@map("meal_items")
}
